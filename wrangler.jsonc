{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "papertrip",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-02",
  // better-auth needs node:crypto (and friends) at runtime.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TRIPS",
        "class_name": "TripDurableObject",
      },
    ],
  },
  // The deployed worker is the renamed ax26 worker: its DO namespace was
  // created at v1 as AX26DurableObject, so the class rename must ship as a
  // rename migration (which also keeps the legacy trip's stored data).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AX26DurableObject"] },
    { "tag": "v2", "renamed_classes": [{ "from": "AX26DurableObject", "to": "TripDurableObject" }] },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "papertrip",
      "database_id": "08d77f32-e19b-46ad-806f-0f0e545f65c3",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://papertrip.xyspg.moe",
    "APP_ORIGIN": "https://papertrip.xyspg.moe",
    "EMAIL_FROM": "PaperTrip <noreply@xyspg.moe>",
    "GEMINI_MODEL": "gemini-3.5-flash",
  },
}
